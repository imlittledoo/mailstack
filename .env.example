# MailStack configuration. Generate a real .env with:  ./mailstack.sh init
# Passwords and keys must be alphanumeric (they are embedded in config files).

# Public FQDN of this mail server. Needs an A record (and PTR) pointing at this host.
MAIL_HOSTNAME=mail.example.com
TZ=UTC

# --- Database ---
DB_NAME=mailstack
DB_USER=mailstack
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me

# --- Admin panel ---
# Initial admin account, created on first start only (change the password in the UI afterwards).
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me
# Optional key for the REST API (send as "X-API-Key" header). Leave empty to disable.
API_KEY=

# --- Internal service secrets ---
RSPAMD_PASSWORD=change-me
DOVEADM_API_KEY=change-me

# --- TLS / Let's Encrypt ---
ACME_EMAIL=
# Extra names for the certificate, comma separated (e.g. autodiscover.example.com,mta-sts.example.com)
ADDITIONAL_SAN=
# y = never request Let's Encrypt certificates (self-signed is used unless you supply your own)
SKIP_LETSENCRYPT=n
ACME_STAGING=n

# --- Mail ---
MESSAGE_SIZE_LIMIT_MB=50
DKIM_SELECTOR=dkim
DKIM_KEY_BITS=2048
# MTA-STS policy mode: none | testing | enforce
MTA_STS_MODE=testing
# Optional smarthost for outbound mail, e.g. [smtp.provider.com]:587
RELAYHOST=
RELAYHOST_USER=
RELAYHOST_PASSWORD=
# Used by the DNS checker to verify A/AAAA/PTR records
PUBLIC_IPV4=
PUBLIC_IPV6=

# --- Optional components ---
# Comma separated compose profiles. Add "clamav" for virus scanning (needs ~1.5 GB RAM).
COMPOSE_PROFILES=

# --- Networking ---
# Host ports. Prefix with an IP to bind to one address, e.g. HTTP_PORT=127.0.0.1:8080
HTTP_PORT=80
HTTPS_PORT=443
SMTP_PORT=25
SMTPS_PORT=465
SUBMISSION_PORT=587
IMAP_PORT=143
IMAPS_PORT=993
POP3_PORT=110
POP3S_PORT=995
SIEVE_PORT=4190
# Internal Docker network (first three octets of a /24)
IPV4_NETWORK=172.22.1
# Optional upstream resolvers for unbound (space separated). Empty = full recursion (recommended for DNSBLs).
DNS_FORWARDERS=
