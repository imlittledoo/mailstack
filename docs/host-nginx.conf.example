# Host nginx in front of MailStack (used when ports 80/443 are taken by another web server).
# Generated by ./generate_config.sh with your hostname filled in.
# Requires MailStack to run with HTTP_PORT=127.0.0.1:8088 and HTTPS_PORT=127.0.0.1:8448 in .env.
# If your nginx is older than 1.25.1, replace "http2 on;" with "http2" on the listen lines.

server {
    listen 80;
    listen [::]:80;
    server_name mail.example.com;
    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name mail.example.com;

    # The certificate maintained by MailStack's acme container.
    ssl_certificate     /var/lib/docker/volumes/mailstack_certs/_data/cert.pem;
    ssl_certificate_key /var/lib/docker/volumes/mailstack_certs/_data/key.pem;

    client_max_body_size 50m;
    location / {
        proxy_pass https://127.0.0.1:8448;
        proxy_ssl_server_name on;
        proxy_ssl_name mail.example.com;
        proxy_ssl_verify off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 120s;
    }
}
