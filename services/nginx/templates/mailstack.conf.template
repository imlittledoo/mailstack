server_tokens off;

# When another reverse proxy (e.g. a host nginx) fronts this container, trust the
# client IP it forwards. Only private/Docker ranges are trusted, and the web ports
# should then be published on 127.0.0.1 only.
set_real_ip_from 127.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 10.0.0.0/8;
real_ip_header X-Real-IP;

# Resolve upstreams at request time so recreated containers (new IPs) keep working.
resolver 127.0.0.11 valid=10s ipv6=off;

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 80 default_server;
  server_name _;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/acme;
    default_type text/plain;
    try_files $uri =404;
  }

  # Thunderbird probes autoconfig over plain HTTP; the response contains no secrets.
  location ~ ^/(mail/config-v1\.1\.xml|\.well-known/autoconfig/mail/config-v1\.1\.xml)$ {
    set $u_admin admin:8000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://$u_admin;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl default_server;
  http2 on;
  server_name _;

  ssl_certificate /etc/ssl/mail/cert.pem;
  ssl_certificate_key /etc/ssl/mail/key.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  client_max_body_size ${MESSAGE_SIZE_LIMIT_MB}m;

  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "same-origin" always;

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;
  proxy_read_timeout 120s;

  location = /webmail {
    return 301 /webmail/;
  }
  location /webmail/ {
    set $u_webmail webmail:80;
    rewrite ^/webmail/(.*)$ /$1 break;
    proxy_pass http://$u_webmail;
  }

  # --- CalDAV / CardDAV (Radicale) -------------------------------------
  location = /.well-known/caldav {
    return 301 /dav/;
  }
  location = /.well-known/carddav {
    return 301 /dav/;
  }
  location = /dav {
    return 301 /dav/;
  }
  location /dav/ {
    auth_request /_dav_auth;
    auth_request_set $dav_user $upstream_http_x_mailstack_user;
    set $u_dav radicale:5232;
    rewrite ^/dav/(.*)$ /$1 break;
    # A location with its own proxy_set_header inherits none from the server block.
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Script-Name /dav;
    proxy_set_header X-Remote-User $dav_user;
    proxy_set_header Authorization "";
    proxy_pass http://$u_dav;
  }
  location = /_dav_auth {
    internal;
    set $u_admin admin:8000;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_pass http://$u_admin/internal/dav-auth;
  }
  location ^~ /internal/ {
    return 404;
  }

  location = /rspamd {
    return 301 /rspamd/;
  }
  location /rspamd/ {
    set $u_rspamd rspamd:11334;
    rewrite ^/rspamd/(.*)$ /$1 break;
    proxy_pass http://$u_rspamd;
  }

  location / {
    set $u_admin admin:8000;
    proxy_pass http://$u_admin;
  }
}
