# Radicale CalDAV/CardDAV server. Authentication is done by nginx + the admin service
# (auth_request), which passes the verified mailbox address in X-Remote-User.
# This port is only reachable on the internal Docker network.

[server]
hosts = 0.0.0.0:5232
max_content_length = 100000000
timeout = 60

[auth]
type = http_x_remote_user

[rights]
type = owner_only

[storage]
filesystem_folder = /data/collections

[web]
type = internal

[logging]
level = info
mask_passwords = True
